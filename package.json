{
  "name": "cinima",
  "private": true,
  "version": "0.1.0",
  "description": "Cinima — social taste discovery Mini App for Nimiq Pay",
  "scripts": {
    "dev": "pnpm --parallel --filter @cinima/api --filter @cinima/web run dev",
    "dev:web": "pnpm --filter @cinima/web dev",
    "dev:api": "pnpm --filter @cinima/api dev",
    "dev:shared": "pnpm --filter @cinima/shared dev",
    "build": "pnpm --filter @cinima/shared build && pnpm --filter @cinima/api build && pnpm --filter @cinima/web build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter @cinima/api test && pnpm --filter @cinima/web test",
    "check:share-preview": "bash scripts/check-share-preview.sh",
    "db:push": "pnpm --filter @cinima/api db:push"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
