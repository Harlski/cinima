# Server
PORT=8787
DATABASE_URL=file:./data/nimcharts.db

# External APIs (optional - seed catalog works without keys)
TMDB_API_KEY=
OMDB_API_KEY=

# Nimiq
TREASURY_ADDRESS=NQ07 0000 0000 0000 0000 0000 0000 0000 0000
NIMIQ_RPC_URL=https://rpc.nimiqwatch.com
NIMCONNECT_BASE_URL=https://nimconnect.nimiq.com

# Security
SESSION_SECRET=change-me-to-a-long-random-string

# Development
DEMO_MODE=true
WEB_ORIGIN=http://localhost:5174
CATALOG_TTL_DAYS=10

# Web (apps/web/.env)
# VITE_API_BASE=
# VITE_TREASURY_ADDRESS=NQ07 0000 0000 0000 0000 0000 0000 0000 0000
# VITE_DEMO_MODE=1
# VITE_ALLOW_DEV_BYPASS=true
