# Server
PORT=8787
STUDIO_PORT=8788

# Local dev: file SQLite under apps/api/data
DATABASE_URL=file:./data/cinima.db

# Production (Turso / remote LibSQL): libsql://your-db.turso.io
# DATABASE_URL=libsql://your-db-name-org.turso.io
# DATABASE_AUTH_TOKEN=

# External APIs (optional - seed catalog works without keys)
TMDB_API_KEY=

# Nimiq
NIMIQ_RPC_URL=https://rpc.nimiqwatch.com

# Security
SESSION_SECRET=change-me-to-a-long-random-string

# Development
DEMO_MODE=true
WEB_ORIGIN=http://localhost:5174
CATALOG_TTL_DAYS=10

# Production (Linode VPS + Vercel frontend)
# DEMO_MODE=false
# WEB_ORIGIN=https://cinima.app
# DATABASE_URL=file:./data/cinima.db   # persisted via deploy/compose.api.yml volume
# STUDIO_INLINE=0                      # Studio runs as a second container on :8788
# STUDIO_UPSTREAM=http://studio:8788   # API forwards GET /api/studio to that container
# VITE_API_BASE=https://api.cinima.app # set in Vercel project env, not on the API host
# API_ORIGIN=https://api.cinima.app    # optional; Edge middleware OG proxy (defaults with VITE_API_BASE)

# Web (apps/web/.env)
# VITE_SITE_ORIGIN=https://cinima.app
# VITE_API_BASE=
# VITE_DEMO_MODE=1
# VITE_ALLOW_DEV_BYPASS=true
